# Copy this file to .env and fill in your PostgreSQL password. The app runs on PostgreSQL only.

# Main application database. Create it with: npm run db:setup
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fraud_detection

# Separate database for the automated tests (wiped and re-seeded on every test run).
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fraud_detection_test

# Hosted (Vercel): do not use this file. Connect a cloud PostgreSQL in Vercel (Project > Storage, e.g. Neon);
# it injects DATABASE_URL (POSTGRES_URL is also accepted). SSL is switched on automatically for non-local servers;
# add ?sslmode=no-verify only if your provider uses a certificate Node.js does not trust.
