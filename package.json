{
  "name": "fraud-framework",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "seed": "npm run seed -w server",
    "dev": "npm-run-all --parallel dev:server dev:client dev:masking",
    "dev:masking": "node scripts/masking-service.mjs",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "build": "npm run build -w client",
    "test-guide": "tsx scripts/build-test-guide.ts",
    "db:setup": "npm run db:setup -w server",
    "test:ui": "playwright test",
    "ai:backfill": "npm run ai:backfill -w server",
    "test:all": "powershell -ExecutionPolicy Bypass -File scripts/run-all-tests.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "exceljs": "^4.4.0",
    "npm-run-all": "^4.1.5"
  }
}
